# Database (PostgreSQL / Supabase Pooler) - Server-only
DATABASE_URL=postgresql://<user>:<password>@<pooler-host>:<port>/postgres

# Google Gemini AI API Key - Server-only (Never prefix with NEXT_PUBLIC_)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Optional Gemini model overrides
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_FAST_MODEL=gemini-2.5-flash-lite
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Kore
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Android Capacitor Shell URL
CAP_SERVER_URL=https://your-deployment.example.com
